# ============================================================
# 岐黄溯智 · 环境变量模板
# 用法：复制本文件为 .env，把占位值替换为自己的配置
#       cp .env.example .env
# 注意：.env 已在 .gitignore 中，永远不要提交真实密钥
# ============================================================

# ---------- DeepSeek（问答生成模型，必需）----------
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FLASH=deepseek-chat
DEEPSEEK_MODEL_PRO=deepseek-reasoner
DEEPSEEK_MODEL_CHAT=deepseek-chat

# ---------- 阿里云百炼（可选，备用 embedding / 模型）----------
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL_NAME=qwen-plus
DASHSCOPE_MODEL_EMBEDDING_NAME=text-embedding-v3

# ---------- Tavily（可选，联网检索）----------
TAVILY_API_KEY=your_tavily_api_key_here

# ---------- MySQL（必需）----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=tcm

# ---------- 本地嵌入模型 ----------
# 克隆后需自行下载 bge-small-zh-v1.5 放到 models/ 目录
# 例如 Hugging Face: BAAI/bge-small-zh-v1.5
EMBED_MODEL_PATH=models/models/BAAI--bge-small-zh-v1.5/snapshots/master
